# ============================
# Solver Parameter File (Channel Turbulence)
# ============================

# physical parameters
Re = 180
Ma = 0.1
gamma = 1.4
Pr = 0.71

# time stepping
cfl = 0.5
dt_fixed = -0.001

# reconstruction and schemes
fvs_type = LaxFriedrichs
interpolation = MDCD_LINEAR
char_recon = False
riemann_solver = Roe

# mdcd parameters (kept for compatibility)
mdcd_disp = 0.0463783
mdcd_diss = 0.020

# grid (overwritten by grid.h5 when use_grid_file=true)
global_nx = 48
global_ny = 36
global_nz = 36
x0 = 0.0
y0 = -1.0
z0 = 0.0
Lx = 6.283185307179586
Ly = 2
Lz = 3.141592653589793

# boundary conditions
bc_xmin = Periodic
bc_xmax = Periodic
bc_ymin = Wall
bc_ymax = Wall
bc_zmin = Periodic
bc_zmax = Periodic

# periodic coordinate shift vectors for ghost coordinates
# non-periodic directions must be set to zero
periodic_xi_px = 6.283185307179586
periodic_xi_py = 0.0
periodic_xi_pz = 0.0
periodic_eta_px = 0.0
periodic_eta_py = 0.0
periodic_eta_pz = 0.0
periodic_zeta_px = 0.0
periodic_zeta_py = 0.0
periodic_zeta_pz = 3.141592653589793

# body force (drives streamwise Poiseuille flow)
use_body_force = True
body_force_x = 1.0
body_force_y = 0.0
body_force_z = 0.0

# simulation control
max_steps = 100
monitor_stepfreq = 1
output_timefreq = 0.1
totaltime = 3.0

# initialization source
restart = False
restart_file = restart.h5
use_grid_file = True
grid_file = grid_channel_turbulence.h5

# post-processing / monitor
post_basicfield = True
isotropicanalyse = False
monitor_res = True
monitor_energy = True
