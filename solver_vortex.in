# ==============================================
# Solver Parameter File: Isentropic Vortex
# ==============================================

# physical parameters
Re = 1000000
Ma = 0.8451542547285
gamma = 1.4
Pr = 0.71

# time stepping
cfl = 0.8
dt_fixed = -1.0

# reconstruction and schemes
fvs_type = LaxFriedrichs
interpolation = WENO5
char_recon = True
riemann_solver = Roe

# mdcd parameters (kept for compatibility)
mdcd_disp = 0.0463783
mdcd_diss = 0.020

# periodic box (isentropic vortex convection)
global_nx = 128
global_ny = 128
global_nz = 16
x0 = 0.0
y0 = 0.0
z0 = 0.0
Lx = 10.0
Ly = 10.0
Lz = 1.0

# boundary conditions (fully periodic)
bc_xmin = Periodic
bc_xmax = Periodic
bc_ymin = Periodic
bc_ymax = Periodic
bc_zmin = Periodic
bc_zmax = Periodic

# periodic coordinate shift vectors
periodic_xi_px = 10.0
periodic_xi_py = 0.0
periodic_xi_pz = 0.0
periodic_eta_px = 0.0
periodic_eta_py = 10.0
periodic_eta_pz = 0.0
periodic_zeta_px = 0.0
periodic_zeta_py = 0.0
periodic_zeta_pz = 1.0

# simulation control
max_steps = 500000
monitor_stepfreq = 10
output_timefreq = 0.5
totaltime = 10

# initialization source
restart = False
restart_file = ./output/field.h5
use_grid_file = True
grid_file = grid_curl.h5

# post-processing / monitor
post_basicfield = True
isotropicanalyse = False
monitor_res = True
monitor_energy = True
